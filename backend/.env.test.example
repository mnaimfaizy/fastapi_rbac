#############################################
# FastAPI RBAC environment variables - Testing
#
# Template for backend/.env.test, which the test compose files load and which
# is git-ignored. Copy it verbatim to run the integration suite:
#
#     cp .env.test.example .env.test
#
# Every value here is a throwaway for the disposable test containers. Nothing
# in this file is a secret and nothing in it may be reused outside testing.
#############################################
MODE=testing
ENVIRONMENT=testing
PROJECT_NAME=fastapi-sqlmodel-alembic-test
FIRST_SUPERUSER_PASSWORD=admin123
FIRST_SUPERUSER_EMAIL=admin@example.com
ENCRYPT_KEY=ZmFzdGFwaS1yYmFjLXRlc3Qtb25seS1rZXktMzJieXQ=
JWT_REFRESH_SECRET_KEY=testing_jwt_refresh_secret_key_not_a_secret
JWT_RESET_SECRET_KEY=testing_jwt_reset_secret_key_not_a_secret
JWT_VERIFICATION_SECRET_KEY=testing_jwt_verification_secret_key_not_a_secret
SECRET_KEY=testing_secret_key_not_a_secret
JWT_SECRET_KEY=testing_jwt_secret_key_not_a_secret
ALGORITHM=HS256
BACKEND_CORS_ORIGINS=["*"]
TOKEN_ISSUER=fastapi_rbac_test
TOKEN_AUDIENCE=fastapi_rbac_users_test
USER_CHANGED_PASSWORD_DATE=2025-06-12
USERS_OPEN_REGISTRATION=true
DEBUG=true
LOG_LEVEL=DEBUG
# PASSWORD_RESET_URL and EMAIL_VERIFICATION_URL are derived from this.
# Set them explicitly only to point a link somewhere other than FRONTEND_URL.
FRONTEND_URL=http://localhost:3001

#############################################
# Token Settings - Testing
#############################################
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=144000
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
UNVERIFIED_ACCOUNT_CLEANUP_HOURS=72
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
PASSWORD_HISTORY_SIZE=5
PREVENT_PASSWORD_REUSE=5

#############################################
# Database Configuration - PostgreSQL (Testing)
#############################################
DATABASE_TYPE=postgresql
DATABASE_HOST=fastapi_rbac_db_test
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=fastapi_rbac_test_db
DATABASE_CELERY_NAME=celery_schedule_jobs_test
DATABASE_PORT=5432

#############################################
# Email settings (MailHog for Testing)
#############################################
EMAILS_ENABLED=true
SMTP_HOST=fastapi_rbac_mailhog_test
SMTP_PORT=1025
SMTP_TLS=false
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=test@fastapi-rbac.com
EMAILS_FROM_NAME=FastAPI RBAC Test

#############################################
# Admin User Creation Settings
#############################################
# Whether admin-created users should be automatically verified (true/false)
ADMIN_CREATED_USERS_AUTO_VERIFIED=true
# Whether to send verification emails to admin-created users (true/false)
ADMIN_CREATED_USERS_SEND_EMAIL=false

#############################################
# Redis variables (for Testing)
#############################################
REDIS_HOST=fastapi_rbac_redis_test
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://fastapi_rbac_redis_test:6379/0

#############################################
# Celery Configuration - Testing
#############################################
CELERY_BROKER_URL=redis://fastapi_rbac_redis_test:6379/0
CELERY_RESULT_BACKEND=redis://fastapi_rbac_redis_test:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true
CELERY_BROKER_CONNECTION_RETRY=true
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=true
CELERY_BROKER_CONNECTION_MAX_RETRIES=5

#############################################
# PgAdmin Configuration - Testing
#############################################
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
