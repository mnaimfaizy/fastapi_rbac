#############################################
# Hub runtime SPLIT — copy to .env on each VM
#   cp env.example .env
# API VM:    ./bootstrap-api.sh
# Worker VM: ./bootstrap-worker.sh
# Fill Neon + Upstash before bootstrap (do not use hostnames db/redis).
#############################################

# Pin a published release by default.
IMAGE_TAG=v1.2.3

# Public API hostname (API VM / Caddy only)
DOMAIN=rbac-api.mnfprofile.com

# Application
MODE=production
PROJECT_NAME=fastapi-rbac
DEBUG=false
LOG_LEVEL=INFO
USERS_OPEN_REGISTRATION=false

TOKEN_ISSUER=fastapi-rbac
TOKEN_AUDIENCE=rbac-api.mnfprofile.com
USER_CHANGED_PASSWORD_DATE=2026-01-01

# Leave empty — bootstrap generates if missing
SECRET_KEY=
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
JWT_RESET_SECRET_KEY=
JWT_VERIFICATION_SECRET_KEY=
ENCRYPT_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Neon (or other managed Postgres) — required; not Compose service "db"
DATABASE_TYPE=postgresql
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
# Same Neon project DB is fine on free tier if you only have one database:
DATABASE_CELERY_NAME=
# If connections fail without SSL, set full URIs from the Neon dashboard, e.g.:
# ASYNC_DATABASE_URI=postgresql+asyncpg://USER:PASS@HOST/DB?ssl=require

# Upstash (or other managed Redis) — required; not Compose service "redis"
# REDIS_HOST must be the hostname ONLY (no rediss://, no user, no password, no :port).
# Wrong: REDIS_HOST=rediss://default:TOKEN@xxx.upstash.io:6379
# Right:  REDIS_HOST=xxx.upstash.io
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=true
# Full URLs go here (Celery), not in REDIS_HOST:
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Optional: host path mounted to /app/certs/ca.crt (default Ubuntu CA bundle)
# HOST_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=

BACKEND_CORS_ORIGINS=["https://rbac.mnfprofile.com"]

EMAILS_ENABLED=true
EMAILS_FROM_EMAIL=no-reply@your-domain.com
EMAILS_FROM_NAME=FastAPI RBAC
FRONTEND_URL=https://rbac.mnfprofile.com
EMAIL_VERIFICATION_URL=https://rbac.mnfprofile.com/verify-email
PASSWORD_RESET_URL=https://rbac.mnfprofile.com/reset-password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
