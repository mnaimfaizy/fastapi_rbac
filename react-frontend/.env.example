### React Frontend Environment Variables

# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Access tokens are memory-only; refresh tokens are HttpOnly cookies (ADR 0006).
# Legacy VITE_*_TOKEN_NAME vars are unused and may be removed from local .env files.

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ADVANCED_FEATURES=true

# App Configuration
VITE_APP_NAME=FastAPI RBAC
VITE_APP_VERSION=1.0.0