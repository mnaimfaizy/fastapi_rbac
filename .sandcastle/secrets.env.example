# Do NOT create .sandcastle/.env. Sandcastle forwards every key in it into
# the sandbox, whichever agent runs, and the scripts refuse to start if it
# holds any keys.
#
# Put credentials in your shell, in `op run`, or in .sandcastle/secrets.env
# (gitignored, read only by the host scripts). Only the selected agent's one
# credential is passed into the sandbox. Copy this file to .sandcastle/secrets.env.

# Default agent: claude | cursor | copilot (or pass --agent).
# SANDCASTLE_AGENT=cursor

# Model overrides per agent (or pass --model).
# SANDCASTLE_CLAUDE_MODEL=claude-opus-5-5
# SANDCASTLE_CURSOR_MODEL=composer-2.5
# SANDCASTLE_COPILOT_MODEL=claude-sonnet-5.5

# Claude: provide one. The OAuth token wins when both are set, unless
# SANDCASTLE_CLAUDE_AUTH=subscription|api forces one.
#   CLAUDE_CODE_OAUTH_TOKEN: `claude setup-token` on the host (Pro/Max plan)
#   ANTHROPIC_API_KEY: metered API billing
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# SANDCASTLE_CLAUDE_AUTH=

# Cursor
# CURSOR_API_KEY=

# Copilot: a fine-grained token (github_pat_...) with only the
# "Copilot Requests" permission and no repository access. Classic (ghp_)
# and gh-login (gho_) tokens are refused.
# COPILOT_GITHUB_TOKEN=
